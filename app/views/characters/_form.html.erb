<div class="flex justify-center">
  <div class="card w-full max-w-2xl bg-base-100 shadow-xl">
    <div class="card-body">
      <%= form_with(model: character) do |form| %>
        <% if character.errors.any? %>
          <div class="alert alert-error mb-4">
            <div class="flex flex-col">
              <h2><%= pluralize(character.errors.count, "error") %> prohibited this character from being saved:</h2>
              <ul class="list-disc list-inside">
                <% character.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>
        <div class="form-control w-full">
          <%= form.label :name, class: "label" %>
          <%= form.text_field :name,
              class: "input input-bordered w-full",
              placeholder: "Enter character name" %>
        </div>
        <div class="form-control w-full">
          <%= form.label :filename, class: "label" %>
          <%= form.text_field :filename,
              class: "input input-bordered w-full",
              placeholder: "Filename" %>
          <p class="text-sm text-gray-500 mt-1">If you already use a custom portrait filename, enter it here. If you don't, leave it blank and one will be generated for you.</p>
        </div>
        <div class="form-control w-full">
          <%= form.label :portrait, class: "label" %>
          <%= form.file_field :portrait, class: "file-input file-input-bordered w-full max-w-xs" %>
        </div>
        <div class="card-actions justify-end mt-6">
          <%= form.submit class: "btn btn-primary" %>
          <%= link_to "Cancel", characters_path, class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
