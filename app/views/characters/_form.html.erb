<div class="flex justify-center">
  <div class="card w-full max-w-2xl bg-base-100 shadow-xl">
    <div class="card-body">
      <%= form_with(model: character) do |form| %>
        <% if character.errors.any? %>
          <div class="alert alert-error mb-4">
            <div class="flex flex-col">
              <h2><%= pluralize(character.errors.count, "error") %> prohibited this character from being saved:</h2>
              <ul class="list-disc list-inside">
                <% character.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>
        <div class="form-control w-full mt-5">
          <%= form.label :name, class: "label" %>
          <%= form.text_field :name,
              class: "input input-bordered w-full #{'input-error' if character.errors[:name].any?}",
              placeholder: "Enter character name" %>
          <% if character.errors[:name].any? %>
            <div class="text-error text-sm mt-1">
              <%= character.errors[:name].join(", ") %>
            </div>
          <% end %>
        </div>
        <div class="form-control w-full mt-5">
          <%= form.label :server_id, "Server", class: "label" %>
          <%= form.collection_select :server_id, Server.order(:name), :id, :name,
              { selected: Server.order(:name).first&.id },
              class: "select select-bordered w-full #{'select-error' if character.errors[:server_id].any?}" %>
          <% if character.errors[:server_id].any? %>
            <div class="text-error text-sm mt-1">
              <%= character.errors[:server_id].join(", ") %>
            </div>
          <% end %>
        </div>
        <div class="form-control w-full mt-5">
          <%= form.label :filename, "Filename (optional)", class: "label" %>
          <p class="text-sm text-gray-500 my-2">If you already know your custom portrait filename, enter it here. If you don't, leave it blank and one will be generated for you.</p>
          <%= form.text_field :filename,
              class: "input input-bordered w-full #{'input-error' if character.errors[:filename].any?}",
              placeholder: "Example: clssorcerer_" %>
          <% if character.errors[:filename].any? %>
            <div class="text-error text-sm mt-1">
              <%= character.errors[:filename].join(", ") %>
            </div>
          <% end %>
        </div>
        <div class="divider"></div>
        <div class="form-control w-full mt-5">
          <h3 class="text-lg font-semibold mb-2">Portrait Images</h3>
          <p class="text-sm text-gray-500 mb-4">
            Upload TGA format images for each portrait size. Images will be automatically resized to the correct dimensions.
            If you don't upload an image for a size, a default portrait will be used.
          </p>
          <div class="space-y-4">
            <% Portrait::TYPES.each do |size, dimensions| %>
              <%= form.fields_for :portraits, character.portraits.find_or_initialize_by(size: size) do |portrait_form| %>
                <div class="form-control">
                  <%= portrait_form.label :file, "#{dimensions[:name]} Portrait (TGA file, #{dimensions[:width]}x#{dimensions[:height]})", class: "label" %>
                  <%= portrait_form.file_field :file,
                      class: "file-input file-input-bordered w-full #{'file-input-error' if portrait_form.object.errors.any?}",
                      accept: ".tga" %>
                  <% if portrait_form.object.errors.any? %>
                    <div class="text-error text-sm mt-1">
                      <%= portrait_form.object.errors.full_messages.join(", ") %>
                    </div>
                  <% end %>
                  <%= portrait_form.hidden_field :size, value: size %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="card-actions justify-end mt-6">
          <%= form.submit class: "btn btn-primary" %>
          <%= link_to "Cancel", characters_path, class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
