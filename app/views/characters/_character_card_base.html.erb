<div class="card w-96 bg-base-100 shadow-xl m-4">
  <figure class="px-10 pt-10">
    <% if huge_portrait = character.portraits.find_by(size: :huge) %>
      <%= image_tag huge_portrait.web_variant, class: "rounded-xl", alt: "#{character.name} portrait" %>
    <% else %>
      <%= image_tag "fallback.webp", class: "rounded-xl", alt: "Default portrait" %>
    <% end %>
  </figure>
  <div class="card-body items-center text-center">
    <h2 class="card-title"><%= character.name %></h2>
    <p><span class="font-bold">User:</span> <%= truncate(character.user.username, length: 30) %></p>
    <p><span class="font-bold">Filename:</span> <%= truncate(character.filename, length: 30) %></p>
    <p><span class="font-bold">Server:</span> <%= truncate(character.server.name, length: 30) %></p>
    <%= yield if block_given? %>
  </div>
</div>
