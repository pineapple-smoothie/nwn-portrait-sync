<%= render "character_card_base", character: character do %>
  <div class="card-actions justify-center">
    <%= link_to "View", character_path(character), class: "btn btn-sm btn-outline btn-primary" %>
    <%= link_to "Edit", edit_character_path(character), class: "btn btn-sm btn-outline btn-primary" %>
    <%= button_to "Delete", character,
          method: :delete,
          class: "btn btn-sm btn-outline btn-error",
          form: { class: "inline" },
        data: { turbo_confirm: "Are you sure you want to delete #{character.name}? This action cannot be undone." } %>
  </div>
<% end %>
