<p style="color: green"><%= notice %></p>
<% content_for :title, "All Characters" %>
<div class="text-center mb-8">
  <h1 class="text-3xl font-bold">All Characters</h1>
</div>
<div class="flex flex-wrap justify-center" id="characters">
  <% @characters.each do |character| %>
    <%= render partial: "character_card", locals: { character: character } %>
  <% end %>
</div>
<%= paginate @characters %>
