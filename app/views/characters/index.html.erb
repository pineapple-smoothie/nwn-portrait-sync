<p style="color: green"><%= notice %></p>
<% content_for :title, "Characters" %>
<div class="text-center mb-8">
  <h1 class="text-3xl font-bold">My Characters</h1>
  <%= link_to "Add new character", new_character_path, class: "btn btn-primary mt-4" %>
</div>
<div class="flex flex-wrap justify-center" id="characters">
  <% @characters.each do |character| %>
    <%= render partial: "character_card", locals: { character: character } %>
  <% end %>
</div>
<%= link_to "Download All Portraits", download_all_portraits_characters_path, class: "btn btn-accent mt-4 ml-2", data: { turbo: false }  %>
