<p style="color: green"><%= notice %></p>
<div class="flex flex-col gap-2">
  <%= image_tag @character.portrait.variant(:thumbnail), class: "rounded-xl" %>
</div>
<div>
  <div class="inline-flex gap-2">
    <%= link_to "Edit this character", edit_character_path(@character), class: "btn btn-sm btn-outline btn-primary" %>
    <%= button_to "Destroy this character", @character,
        method: :delete,
        class: "btn btn-sm btn-outline btn-error",
        data: { turbo_confirm: "Are you sure you want to delete this character? This action cannot be undone." } %>
  </div>
</div>
