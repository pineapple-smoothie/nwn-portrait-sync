<h1>Forgot your password?</h1>
<%= form_with url: passwords_path do |form| %>
  <%= form.text_field :login,
      required: true,
      autofocus: true,
      autocomplete: "username",
      placeholder: "Enter your email or username",
      value: params[:login] %>
  <%= form.submit "Email reset instructions" %>
<% end %>
