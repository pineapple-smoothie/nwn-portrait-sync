<% if flash.any? %>
  <div class="toast toast-top toast-end z-50">
    <% flash.each do |type, message| %>
      <% alert_class = case type
         when "notice" then "alert alert-success"
         when "alert" then "alert alert-error"
         when "info" then "alert alert-info"
         else "alert alert-warning"
         end %>
      <div class="<%= alert_class %> shadow-lg relative">
        <div>
          <span><%= message %></span>
          <button class="close-button" onclick="this.parentElement.parentElement.style.display='none';">&times;</button>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    setTimeout(function() {
      document.querySelectorAll('.toast .alert').forEach(function(alert) {
        alert.style.display = 'none';
      });
    }, 5000); // 5000 milliseconds = 5 seconds
  });
</script>
