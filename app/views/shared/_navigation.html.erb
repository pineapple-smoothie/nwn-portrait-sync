<div class="navbar bg-base-100">
  <div class="flex-1">
    <%= link_to "NWN Portrait Sync", root_path, class: "btn btn-ghost text-xl" %>
    <ul class="menu menu-horizontal px-1">
      <li><%= link_to "About", about_path %></li>
      <% if authenticated? %>
        <li><%= link_to "All Characters", characters_path %></li>
        <li><%= link_to "My Characters", mine_characters_path %></li>
      <% end %>
    </ul>
  </div>
  <div class="flex-none">
    <ul class="menu menu-horizontal px-1">
      <% if authenticated? %>
        <li><%= link_to "Logout as #{current_user.email_address}", session_path, data: { turbo_method: :delete } %></li>
      <% else %>
        <li><%= link_to "Login", new_session_path %></li>
        <li><%= link_to "Sign up", new_registration_path %></li>
      <% end %>
    </ul>
  </div>
</div>
