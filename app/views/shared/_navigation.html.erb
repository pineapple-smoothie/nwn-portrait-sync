<div class="navbar bg-base-100">
  <div class="flex-1">
    <%= link_to "NWN Portrait Sync", root_path, class: "btn btn-ghost text-xl" %>
    <ul class="menu menu-horizontal px-1">
      <li><%= link_to "About", about_path %></li>
      <% if authenticated? %>
        <li><%= link_to "All Characters", characters_path %></li>
        <li><%= link_to "My Characters", mine_characters_path %></li>
      <% end %>
    </ul>
  </div>
  <div class="flex-none">
    <ul class="menu menu-horizontal px-1">
      <% if authenticated? %>
        <li><%= link_to "Convert portrait to TGAs", new_conversion_path, class: 'btn btn-sm btn-primary btn-outline mx-2' %></li>
        <li><%= link_to "Download All Portraits", download_all_portraits_characters_path, class: "btn btn-sm btn-accent btn-outline mx-2", data: { turbo: false } %></li>
        <li>
          <details class="dropdown">
            <summary><%= current_user.username %></summary>
            <ul class="p-2 shadow menu dropdown-content z-[1] bg-base-100 rounded-box w-52">
              <li><%= link_to "Logout", session_path, data: { turbo_method: :delete } %></li>
            </ul>
          </details>
        </li>
      <% else %>
        <li><%= link_to "Sign in", new_session_path %></li>
        <li><%= link_to "Sign up", new_registration_path %></li>
      <% end %>
    </ul>
  </div>
</div>
