<div class="min-h-screen flex items-center justify-center">
  <div class="columns-1">
    <div class="card bg-base-100 w-96 shadow-xl">
      <div class="card-body">
        <h2 class="card-title justify-center">Sign In</h2>
        <%= form_with url: session_path do |form| %>
          <div class="mb-4">
            <%= form.label :login, "Email or Username" %>
            <%= form.text_field :login, required: true, autofocus: true, autocomplete: "username", class: "input input-bordered w-full max-w-xs", value: params[:login] %>
          </div>
          <div class="mb-4">
            <%= form.label :password, "Password" %>
            <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input input-bordered w-full max-w-xs" %>
          </div>
          <div class="flex justify-center">
            <%= form.submit "Sign in", class: "btn btn-primary btn-wide" %>
          </div>
        <% end %>
        <br>
        <div class="flex justify-center gap-2">
          <%= link_to "Forgot password?", new_password_path, class: "btn btn-link" %>
          <%= link_to "Sign up", new_registration_path, class: "btn btn-link" %>
        </div>
      </div>
    </div>
  </div>
</div>
