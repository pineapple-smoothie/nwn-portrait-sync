<% content_for :title, "Convert image" %>
<div class="text-center mb-8">
  <h1 class="text-3xl font-bold">Convert your portrait image</h1>
</div>
<%= turbo_frame_tag "conversion_form" do %>
  <div class="flex justify-center">
    <div class="card w-full max-w-2xl bg-base-100 shadow-xl">
      <div class="card-body">
        <%= render "form" %>
      </div>
    </div>
  </div>
<% end %>