<div class="flex justify-center">
  <div class="card w-full max-w-2xl bg-base-100 shadow-xl">
    <div class="card-body">
      <%= form_with(model: @conversion, local: true) do |form| %>
        <% if @conversion.errors.any? %>
          <div class="alert alert-error mb-4">
            <div class="flex flex-col">
              <h2><%= pluralize(@conversion.errors.count, "error") %> prohibited this conversion from being saved:</h2>
              <ul class="list-disc list-inside">
                <% @conversion.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>
        <div class="form-control w-full">
          <%= form.label :image, "Upload your portrait image (JPEG or PNG)", class: "label" %>
          <p class="text-sm text-gray-500 mb-2">
            Your image will be automatically converted and resized into the required TGA formats.
          </p>
          <%= form.file_field :image,
              class: "file-input file-input-bordered w-full #{'file-input-error' if @conversion.errors[:image].any?}",
              accept: "image/jpeg,image/png" %>
          <% if @conversion.errors[:image].any? %>
            <div class="text-error text-sm mt-1">
              <%= @conversion.errors[:image].join(", ") %>
            </div>
          <% end %>
        </div>
        <div class="card-actions justify-end mt-6">
          <%= form.submit "Convert Image", class: "btn btn-primary" %>
          <%= link_to "Cancel", new_character_path, class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
